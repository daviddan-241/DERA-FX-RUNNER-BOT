# ============================================================
#  PRIVATE ALPHA BOT — configuration (copy to .env and fill in)
# ============================================================

# --- Telegram -------------------------------------------------
BOT_TOKEN=123456789:AAE-your-bot-token-from-BotFather
# Your Telegram numeric ID (so only YOU can run admin commands).
# Get it from @userinfobot
OWNER_ID=123456789

# --- Support / docs links --------------------------------------
SUPPORT_LINK=https://t.me/your_support
DOCS_URL=https://runner-bot.gitbook.io/runner-bot-docs

# --- Solana RPC ------------------------------------------------
# Public default works, but a paid RPC (Helius/QuickNode/Ankr) is
# much more reliable for payment checks.
RPC_URL=https://api.mainnet-beta.solana.com
# finalized | confirmed
MIN_CONFIRM_LEVEL=finalized
# how old (hours) a payment tx is allowed to be
TX_WINDOW_HOURS=48

# --- PAYMENT WALLET -------------------------------------------------
# You do NOT need a private key: paste the PUBLIC address that
# receives the payments, and the bot verifies every transaction
# on-chain against it. (Or skip .env entirely and use /setaddress
# in the bot's DM.)
TREASURY_ADDRESS=
# Optional: private key (base58 / [64-byte array] / seed phrase) —
# ONLY needed for automatic referral-credit payouts. Or leave empty
# and use /importwallet in the bot's DM.
TREASURY_PRIVATE_KEY=

# --- PUBLIC CHANNEL (free for everyone) -------------------------
PUBLIC_CHANNEL_LINK=https://t.me/drakeinsider

# --- USER TRADING WALLETS --------------------------------------
# MASTER SEED: when set, the bot derives a UNIQUE deterministic
# wallet for every user (sha256(seed | user_id)) when they tap
# "GENERATE WALLET" on the trade side. Leave empty to generate
# random wallets per user instead.
WALLET_SEED=

# --- Membership plans (prices in SOL, days; 0 days = lifetime) --
# Raised from the original bot's 0.1/0.3/3.0 SOL.
# Channel IDs: easiest way -> DM the bot "/setchannel newbie" and
# forward ANY message from that channel (bots can't read t.me/+
# invite links). You can also paste the numeric id here directly.
NEWBIE_PRICE=1
NEWBIE_DAYS=30
# optional private channel unlocked by this plan (bot must be admin there):
NEWBIE_CHANNEL_ID=

BEGINNER_PRICE=2
BEGINNER_DAYS=30
BEGINNER_CHANNEL_ID=

PRO_PRICE=4
PRO_DAYS=30
PRO_CHANNEL_ID=

ELITE_PRICE=8
ELITE_DAYS=60
ELITE_CHANNEL_ID=

# --- Channel subscriptions (the "channel side") ----------------
# Same channel system — each channel with ITS OWN price and
# ITS OWN duration:
# Format: Name|channel_id|price|days  (separate multiple with ;)
# days=0 means lifetime. Users buy each one separately.
CHANNEL_PASSES=VIP Signals|-1001234567890|5|30;Alpha Calls|-1000987654321|10|45

# --- Limit orders ----------------------------------------------
# How many times the bot retries a limit order before cancelling it.
LIMIT_MAX_ATTEMPTS=3

# How access is granted:
#   invite  -> bot must be ADMIN in the channel; sends 1-use invite link
#   approve -> channel must have join requests ON; bot approves them
CHANNEL_ACCESS_METHOD=invite

# --- Referrals / gating ----------------------------------------
REF_PERCENT=50
FREE_REPORTS=3

# --- Expiry reminders (DM) -------------------------------------
# Hours before the end of a subscription the user gets a DM reminder
# (with a Renew button). They also get a DM when it expires.
REMIND_BEFORE_HOURS=48,24,6,1

# --- Misc ------------------------------------------------------
TZ=Africa/Lagos
AD_LINE=Trade, Earn & Launch on Vyper
# Optional: tag top-holder wallets with KOL names for /kols report
# KOL_TAGS=Wallet=Name,Wallet2=Name2
# Optional: OpenAI key for /ai (beta)
# OPENAI_API_KEY=
